---
import '@fontsource-variable/inter';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';
import '@fontsource-variable/inter';
import '@fontsource-variable/inter/wght-italic.css';
import '@/styles/global.css';
type JsonLd = Record<string, unknown>;

interface Props {
  title: string;                       // page title, e.g. "Products" → "Products - VendorLift"
  description: string;                 // 160 characters or fewer
  canonical?: string;                  // override (blog posts have a canonicalUrl field)
  ogImage?: string;                    // social preview image, 1200x630
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  publishedAt?: string;                // ISO date, for blog posts
  modifiedAt?: string;
  noindex?: boolean;                   // true for admin, drafts, thank-you pages
  jsonLd?: JsonLd | JsonLd[];          // page-specific structured data (Product, BlogPosting…)
  transparentHeader?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = '/images/og-default.jpg',
  ogImageAlt = `${site.name} - ${site.tagline}`,
  ogType = 'website',
  publishedAt,
  modifiedAt,
  noindex = false,
  jsonLd,
  transparentHeader = false,
} = Astro.props;

// ---------- Title: "{Page} - {Brand}" (PRD 6.3) ----------
const fullTitle = title.includes(site.name) ? title : `${title} - ${site.name}`;

// ---------- Absolute URLs (canonical, OG and JSON-LD need full URLs) ----------
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const siteUrl = new URL('/', Astro.site).href;

// ---------- Dev warnings for SEO limits ----------
if (import.meta.env.DEV) {
  if (fullTitle.length > 60) {
    console.warn(`[SEO] Title is ${fullTitle.length} chars (max 60): "${fullTitle}"`);
  }
  if (description.length > 160) {
    console.warn(`[SEO] Description is ${description.length} chars (max 160) on ${Astro.url.pathname}`);
  }
}

// ---------- Site-wide structured data (PRD 6.4) ----------
const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: site.name,
      url: siteUrl,
      logo: new URL('/images/logo-square.png', Astro.site).href,
      email: site.email,
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        telephone: site.whatsappDisplay,
        availableLanguage: ['English'],
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: site.name,
      url: siteUrl,
      publisher: { '@id': `${siteUrl}#organization` },
      inLanguage: 'en-NG',
    },
  ],
};

const pageSchemas: JsonLd[] = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// Safely turn an object into JSON for a <script> tag
function toJsonLd(data: unknown) {
  return JSON.stringify(data).replace(/</g, '\\u003c');
}
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Basics -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
        <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large" />}

    <!-- Icons & browser -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#003399" />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Open Graph (Facebook, WhatsApp, LinkedIn previews) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_NG" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogType === 'article' && publishedAt && (
      <meta property="article:published_time" content={publishedAt} />
    )}
    {ogType === 'article' && modifiedAt && (
      <meta property="article:modified_time" content={modifiedAt} />
    )}

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Structured data (JSON-LD) -->
    <script is:inline type="application/ld+json" set:html={toJsonLd(siteSchema)} />
    {pageSchemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={toJsonLd(schema)} />
    ))}
  </head>

  <body class="flex min-h-svh flex-col bg-white text-ink antialiased">
    <Header transparent={transparentHeader} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
        <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if (reduceMotion || !('IntersectionObserver' in window)) {
        revealItems.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
        );

        revealItems.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>