---
import { site } from '@/data/site';
import { navLinks } from '@/data/navigation';
import { whatsappLink } from '@/lib/whatsapp';

const year = new Date().getFullYear();
---

<footer class="border-t-4 border-accent bg-ink text-white/70">
  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-16 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:px-8">
    <!-- Brand -->
    <div class="sm:col-span-2">
       <a href="/" class="text-2xl font-extrabold uppercase tracking-tight text-primary transition hover:text-ink">
      {site.name}
    </a>
      <p class="mt-5 max-w-sm leading-relaxed">
        {site.tagline} Browse the collection and message us on WhatsApp. We'll help you choose.
      </p>
      <a
        href={whatsappLink()}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white transition hover:bg-accent hover:text-ink"
      >
        Chat on WhatsApp
      </a>
    </div>

    <!-- Links -->
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-widest text-accent">Explore</h2>
      <ul class="mt-5 space-y-3">
        {navLinks.map((link) => (
          <li><a href={link.href} class="transition hover:text-accent">{link.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Contact -->
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-widest text-accent">Get in touch</h2>
      <ul class="mt-5 space-y-3">
        <li>
          <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="transition hover:text-accent">
            {site.whatsappDisplay}
          </a>
        </li>
        <li><a href={`mailto:${site.email}`} class="transition hover:text-accent">{site.email}</a></li>
        <li>{site.location}</li>
      </ul>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-6 text-sm sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <p>Prices are in Nigerian Naira (₦).</p>
    </div>
  </div>
</footer>