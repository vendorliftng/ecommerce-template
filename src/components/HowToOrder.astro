---
import SectionHeading from '@/components/SectionHeading.astro';
import type { OrderStep, StepIcon } from '@/data/orderSteps';
import { whatsappLink } from '@/lib/whatsapp';

interface Props {
  steps: OrderStep[];
  eyebrow?: string;
  title?: string;
  text?: string;
}

const {
  steps,
  eyebrow = 'How it works',
  title = 'Ordering is simple',
  text = 'No accounts, no checkout forms. Just pick what you like and talk to us directly.',
} = Astro.props;

// Heroicons (MIT) outline paths, 24x24
const icons: Record<StepIcon, string> = {
  bag: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z',
  chat: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z',
  check: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
};
---

<section aria-labelledby="how-heading" class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading id="how-heading" eyebrow={eyebrow} title={title} text={text} align="center" />

    <div class="relative mx-auto mt-14 max-w-5xl">
      <!-- Dashed connecting line (tablet and desktop only) -->
      <div
        class="absolute left-[16.66%] right-[16.66%] top-8 hidden border-t-2 border-dashed border-accent/60 md:block"
        aria-hidden="true"
      ></div>

      <ol class="relative grid gap-12 md:grid-cols-3 md:gap-8">
        {steps.map((step, i) => (
          <li data-reveal style={`--reveal-delay: ${i * 150}ms`} class="text-center">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-cream text-primary ring-8 ring-white">
              <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={icons[step.icon]} />
              </svg>
            </div>

            <p class="mt-5 text-sm font-bold tracking-widest text-accent" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </p>
            <h3 class="mt-1 text-xl font-semibold text-ink">{step.title}</h3>
            <p class="mx-auto mt-2 max-w-xs text-ink/70">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>

    <div data-reveal style={`--reveal-delay: ${steps.length * 150}ms`} class="mt-14 text-center">
      <a
        href={whatsappLink('Hello VendorLift, I would like to place an order.')}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-primary px-8 py-3.5 font-semibold text-white transition hover:bg-accent hover:text-ink"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d={icons.chat} />
        </svg>
        Start on WhatsApp
      </a>
    </div>
  </div>
</section>