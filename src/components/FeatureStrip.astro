---

<section aria-label="Why shop with us" class="overflow-hidden bg-accent py-5">
  <div class="flex w-max animate-marquee hover:[animation-play-state:paused] motion-reduce:animate-none">
    {[0, 1].map((copy) => (
      <ul class="flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
        {items.map((item) => (
          <li class="flex items-center gap-3 px-10 text-lg font-semibold whitespace-nowrap text-ink">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-ink text-accent">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={icons[item.icon]} />
              </svg>
            </span>
            {item.text}
          </li>
        ))}
      </ul>
    ))}
  </div>
</section>