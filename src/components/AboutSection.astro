---
interface Step {
  title: string;
  text: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  steps?: Step[];
  imageUrl: string;
  imageAlt: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const { eyebrow, title, text, steps = [], imageUrl, imageAlt, ctaLabel, ctaHref } = Astro.props;
---

<section aria-labelledby="about-heading" class="bg-cream py-20 text-ink sm:py-28">
  <div class="mx-auto grid max-w-7xl items-center gap-14 px-4 sm:px-6 lg:grid-cols-2 lg:gap-20 lg:px-8">

    <!-- Image with offset block -->
    <div data-reveal class="relative mb-4 mr-4 sm:mb-6 sm:mr-6">
      <div class="absolute -bottom-4 -right-4 h-full w-full bg-accent/25 sm:-bottom-6 sm:-right-6" aria-hidden="true"></div>
      <img
        src="/images/craft.webp"
        alt={imageAlt}
        width="1200"
        height="900"
        loading="lazy"
        class="relative aspect-[4/3] w-full object-cover"
      />
    </div>

    <!-- Text -->
    <div>
      {eyebrow && (
        <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.3em] text-primary">
          <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
          {eyebrow}
        </p>
      )}
      <h2 id="about-heading" class="mt-4 text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-primary sm:text-6xl">
        {title}
      </h2>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-ink/70">{text}</p>

      {steps.length > 0 && (
        <ol class="mt-10 border-t border-ink/10">
          {steps.map((step, i) => (
            <li data-reveal style={`--reveal-delay: ${i * 120}ms`} class="flex gap-6 border-b border-ink/10 py-6">
              <span class="pt-1 text-sm font-extrabold text-accent" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="text-lg font-extrabold uppercase tracking-wide text-ink">{step.title}</h3>
                <p class="mt-2 text-ink/70">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      )}

      {ctaLabel && ctaHref && (
        <a
          href={ctaHref}
          class="mt-10 inline-flex items-center gap-3 border-2 border-primary px-8 py-4 text-sm font-bold uppercase tracking-[0.25em] text-primary transition hover:bg-primary hover:text-white"
        >
          {ctaLabel}
          <span aria-hidden="true">→</span>
        </a>
      )}
    </div>

  </div>
</section>