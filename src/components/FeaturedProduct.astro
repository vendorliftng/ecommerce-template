---
import ShareButton from '@/components/ShareButton.astro';
import { getProductBySlug } from '@/lib/products';
import { formatPrice } from '@/lib/format';

interface Props {
  slug: string;
  eyebrow?: string;
}

const { slug, eyebrow = 'Featured piece' } = Astro.props;
const product = getProductBySlug(slug);

const href = product ? `/products/${product.slug}/` : '';
const price = product ? formatPrice(product.price, product.currency) : '';
const isOutOfStock = product?.status === 'out_of_stock';
const ctaLabel = isOutOfStock ? 'View details' : 'Shop now';
---

{product && (
  <section aria-labelledby="featured-product-heading" class="bg-white py-16 sm:py-24">
    <div class="mx-auto grid max-w- items-center gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-20 lg:px-8">

      <!-- Image -->
      <a href={href} data-reveal class="group block overflow-hidden rounded-2xl bg-cream" tabindex="-1" aria-hidden="true">
        <img
          src={product.featuredImageUrl}
          alt=""
          width="900"
          height="900"
          loading="lazy"
          class="aspect-square h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
        />
      </a>

      <!-- Details -->
      <div data-reveal style="--reveal-delay: 150ms" class="max-w-xl">
        <p class="flex items-center gap-3 text-sm font-semibold uppercase tracking-widest text-primary">
          <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
          {eyebrow}
        </p>

        <h2 id="featured-product-heading" class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-5xl">
          {product.title}
        </h2>

        <div class="mt-5 flex flex-wrap items-center gap-3">
          <p class="text-2xl font-semibold text-ink">{price}</p>
          <span
            class:list={[
              'rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wider',
              isOutOfStock ? 'bg-ink text-white' : 'bg-primary/10 text-primary',
            ]}
          >
            {isOutOfStock ? 'Out of stock' : 'In stock'}
          </span>
        </div>

        <p class="mt-6 text-lg text-ink/80">{product.shortDescription}</p>
        {product.longDescription && (
          <p class="mt-3 text-ink/70">{product.longDescription}</p>
        )}

        <a
          href={href}
          class="mt-8 flex w-full items-center justify-center gap-2 rounded-full bg-primary px-8 py-4 font-semibold text-white transition hover:bg-accent hover:text-ink sm:inline-flex sm:w-auto"
        >
          {ctaLabel}
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>

        <div class="mt-6 border-t border-ink/10 pt-5">
          <ShareButton path={href} title={product.title} text={product.shortDescription} />
        </div>
      </div>

    </div>
  </section>
)}