---
import SectionHeading from '@/components/SectionHeading.astro';
import PostCard from '@/components/PostCard.astro';
import { getLatestPosts } from '@/lib/posts';

interface Props {
  eyebrow?: string;
  title?: string;
  text?: string;
  limit?: number;
}

const {
  eyebrow = 'From the blog',
  title = 'Tips, guides and stories',
  text = 'Care tips, style guides and help choosing the right piece.',
  limit = 3,
} = Astro.props;

const items = getLatestPosts(limit);
---

{items.length > 0 && (
  <section aria-labelledby="latest-posts-heading" class="bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <SectionHeading id="latest-posts-heading" eyebrow={eyebrow} title={title} text={text} />

        <a
          href="/blog/"
          data-reveal
          class="inline-flex shrink-0 self-start rounded-full bg-primary px-8 py-3 font-semibold text-white transition hover:bg-accent hover:text-ink sm:self-auto"
        >
          View all posts
        </a>
      </div>

      <ul class="mt-12 grid gap-x-6 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
        {items.map((post, i) => (
          <li data-reveal style={`--reveal-delay: ${i * 120}ms`}>
            <PostCard post={post} headingTag="h3" />
          </li>
        ))}
      </ul>
    </div>
  </section>
)}