---
import type { Post } from '@/data/posts';
import { formatDate } from '@/lib/format';
import { readingTime } from '@/lib/posts';

interface Props {
  post: Post;
  headingTag?: 'h2' | 'h3';
  size?: 'default' | 'large';
}

const { post, headingTag = 'h2', size = 'default' } = Astro.props;
const Heading = headingTag;
---

<article class="group relative flex h-full flex-col">
  <div class="aspect-[4/3] overflow-hidden bg-cream">
    <img
      src={post.featuredImageUrl}
      alt={post.featuredImageAlt}
      width="800"
      height="600"
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
    />
  </div>

  <div class="mt-5">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ink/60">
      {post.publishedAt && <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>}
      {' · '}{readingTime(post)} min read
    </p>

    <Heading
      class:list={[
        'mt-3 font-display leading-tight text-primary',
        size === 'large' ? 'text-4xl sm:text-5xl' : 'text-3xl',
      ]}
    >
      <a href={`/blog/${post.slug}/`} class="after:absolute after:inset-0 hover:underline focus-visible:outline-none focus-visible:after:ring-2 focus-visible:after:ring-primary">
        {post.title}
      </a>
    </Heading>

    <p class="mt-3 line-clamp-2 text-ink/75">{post.excerpt}</p>
  </div>
</article>