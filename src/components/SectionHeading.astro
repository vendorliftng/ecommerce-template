---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  text?: string;
  align?: 'center' | 'left';
}

const { id, eyebrow, title, text, align = 'left' } = Astro.props;
const centered = align === 'center';
---

<div data-reveal class:list={['max-w-2xl', centered && 'mx-auto text-center']}>
  {eyebrow && (
    <p
      class:list={[
        'flex items-center gap-3 text-sm font-semibold uppercase tracking-widest text-primary',
        centered && 'justify-center',
      ]}
    >
      <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
      {eyebrow}
      {centered && <span class="h-px w-8 bg-accent" aria-hidden="true"></span>}
    </p>
  )}

  <h2 id={id} class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">
    {title}
  </h2>

  {text && <p class="mt-4 text-lg text-ink/70">{text}</p>}
</div>