---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ContactForm from '@/islands/ContactForm';
import { site } from '@/data/site';
import { whatsappLink } from '@/lib/whatsapp';
import { breadcrumbSchema, type Crumb } from '@/lib/seo';

const crumbs: Crumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Contact' },
];

// Heroicons (MIT) outline paths
const icons = {
  phone: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z',
  mail: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  pin: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z',
};
---

<BaseLayout
  title="Contact Us"
  description="Questions about our leather shoes or bags? Message VendorLift on WhatsApp or send us a note. We're happy to help."
  jsonLd={breadcrumbSchema(crumbs, Astro.site!)}
>
  <section class="bg-cream">
    <div class="mx-auto max-w-7xl px-4 pb-20 pt-6 sm:px-6 sm:pb-28 lg:px-8">
      <Breadcrumbs items={crumbs} />

      <div class="mt-10 grid items-start gap-12 lg:grid-cols-2 lg:gap-20">

        <!-- Left: image (same as About). No fade, so the page counts as fast. -->
        <div class="relative mb-4 mr-4 sm:mb-6 sm:mr-6 lg:sticky lg:top-24">
          <div class="anim-block-slide absolute -bottom-4 -right-4 h-full w-full bg-accent/25 sm:-bottom-6 sm:-right-6" aria-hidden="true"></div>
          <img
            src="/images/craft.webp"
            alt="Hands stitching brown leather on a wooden workbench"
            width="1000"
            height="1250"
            loading="eager"
            fetchpriority="high"
            class="anim-image-settle relative aspect-[4/3] w-full object-cover lg:aspect-[4/5]"
          />
        </div>

        <!-- Right: details + form -->
        <div>
          <div data-reveal>
            <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.3em] text-primary">
              <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
              Get in touch
            </p>
            <h1 class="mt-4 text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-primary sm:text-5xl">
              Contact Us
            </h1>
          </div>

          <p data-reveal style="--reveal-delay: 120ms" class="mt-5 max-w-md text-lg text-ink/70">
            Questions about sizes, colours or delivery? The quickest way to reach us is WhatsApp, or send a message below.
          </p>

          <!-- Contact details -->
          <ul class="mt-8 divide-y divide-ink/10 border-y border-ink/10">
            <li data-reveal style="--reveal-delay: 240ms">
              <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 py-4 transition hover:text-primary">
                <svg class="h-5 w-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={icons.phone} /></svg>
                <span>
                  <span class="block text-xs font-semibold uppercase tracking-wider text-ink/50">WhatsApp</span>
                  <span class="text-lg text-ink">{site.whatsappDisplay}</span>
                </span>
              </a>
            </li>
            <li data-reveal style="--reveal-delay: 340ms">
              <a href={`mailto:${site.email}`} class="flex items-center gap-4 py-4 transition hover:text-primary">
                <svg class="h-5 w-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={icons.mail} /></svg>
                <span>
                  <span class="block text-xs font-semibold uppercase tracking-wider text-ink/50">Email</span>
                  <span class="text-lg text-ink">{site.email}</span>
                </span>
              </a>
            </li>
            <li data-reveal style="--reveal-delay: 440ms" class="flex items-center gap-4 py-4">
              <svg class="h-5 w-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={icons.pin} /></svg>
              <span>
                <span class="block text-xs font-semibold uppercase tracking-wider text-ink/50">Location</span>
                <span class="text-lg text-ink">{site.location}</span>
              </span>
            </li>
          </ul>

          <div data-reveal style="--reveal-delay: 540ms">
            <a
              href={whatsappLink('Hello VendorLift, I have a question.')}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-8 inline-flex w-full items-center justify-center rounded-full bg-primary px-8 py-4 font-semibold text-white transition hover:bg-accent hover:text-ink sm:w-auto"
            >
              Chat on WhatsApp
            </a>
          </div>

          <!-- Form -->
          <div data-reveal class="mt-12 border-t border-ink/10 pt-10">
            <h2 class="text-2xl font-bold text-ink">Prefer to write?</h2>
            <p class="mt-2 text-ink/60">Send us a message and we'll reply on WhatsApp.</p>
            <div class="mt-8">
              <ContactForm client:load />
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>