---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ShareButton from '@/components/ShareButton.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import PostCard from '@/components/PostCard.astro';
import ProductCard from '@/components/ProductCard.astro';
import type { Post } from '@/data/posts';
import { getPublishedPosts } from '@/lib/posts';
import { getFeaturedProducts } from '@/lib/products';
import { formatDate } from '@/lib/format';
import { renderMarkdown } from '@/lib/markdown';
import { whatsappLink } from '@/lib/whatsapp';
import { blogPostingSchema, breadcrumbSchema, type Crumb } from '@/lib/seo';

// One page per published post (drafts and scheduled posts get no page)
export function getStaticPaths() {
  return getPublishedPosts().map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const siteUrl = Astro.site!;

const path = `/blog/${post.slug}/`;
const html = renderMarkdown(post.content);
const wordCount = post.content.split(/\s+/).length;
const readMinutes = Math.max(1, Math.round(wordCount / 200));

const relatedPosts = getPublishedPosts()
  .filter((p) => p.slug !== post.slug)
  .slice(0, 3);
const relatedProducts = getFeaturedProducts(4);

const crumbs: Crumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog/' },
  { label: post.title },
];
---

<BaseLayout
  title={post.seoTitle ?? post.title}
  description={post.seoDescription ?? post.excerpt}
  canonical={post.canonicalUrl}
  ogImage={post.ogImageUrl ?? post.featuredImageUrl}
  ogImageAlt={post.featuredImageAlt}
  ogType="article"
  publishedAt={post.publishedAt}
  modifiedAt={post.updatedAt}
  jsonLd={[blogPostingSchema(post, siteUrl), breadcrumbSchema(crumbs, siteUrl)]}
>
  <article>
    <!-- Header -->
    <header class="mx-auto max-w-3xl px-4 pt-6 sm:px-6">
      <Breadcrumbs items={crumbs} />

      <div class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink/60">
        {post.publishedAt && (
          <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
        )}
        <span aria-hidden="true">·</span>
        <span>{readMinutes} min read</span>
        {post.authorName && (
          <>
            <span aria-hidden="true">·</span>
            <span>By {post.authorName}</span>
          </>
        )}
      </div>

      <h1 class="mt-4 text-3xl font-bold leading-tight tracking-tight text-ink sm:text-5xl">
        {post.title}
      </h1>
      <p class="mt-5 text-lg text-ink/70 sm:text-xl">{post.excerpt}</p>
    </header>

    <!-- Featured image -->
    <div class="mx-auto mt-10 max-w-5xl px-4 sm:px-6">
      <div class="aspect-[16/9] overflow-hidden rounded-2xl bg-cream">
            <!-- Gallery (optional, 2 or 3 images) -->
    {post.gallery && post.gallery.length > 0 && (
      <div class="mx-auto mt-3 max-w-5xl px-4 sm:mt-4 sm:px-6">
        <ul class:list={['grid gap-3 sm:gap-4', post.gallery.length === 2 ? 'grid-cols-2' : 'grid-cols-3']}>
          {post.gallery.map((img, i) => (
            <li data-reveal style={`--reveal-delay: ${i * 120}ms`}>
              <figure class="group">
                {img.href ? (
                  <a href={img.href} class="block aspect-square overflow-hidden rounded-2xl bg-cream">
                    <img
                      src={img.url}
                      alt={img.alt}
                      width="600"
                      height="600"
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                    />
                  </a>
                ) : (
                  <div class="aspect-square overflow-hidden rounded-2xl bg-cream">
                    <img
                      src={img.url}
                      alt={img.alt}
                      width="600"
                      height="600"
                      loading="lazy"
                      class="h-full w-full object-cover"
                    />
                  </div>
                )}
                {img.caption && (
                  <figcaption class="mt-2 text-xs font-semibold uppercase tracking-[0.2em] text-ink/60 sm:text-sm">
                    {img.href ? (
                      <a href={img.href} class="transition hover:text-primary">{img.caption} →</a>
                    ) : (
                      img.caption
                    )}
                  </figcaption>
                )}
              </figure>
            </li>
          ))}
        </ul>
      </div>
    )}
      </div>
    </div>

    <!-- Content -->
    <div
      class="prose prose-lg mx-auto mt-12 max-w-[680px] px-4 sm:px-0
             prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-ink
             prose-p:text-ink/80 prose-li:text-ink/80 prose-strong:text-ink
             prose-a:font-semibold prose-a:text-primary prose-a:no-underline hover:prose-a:underline
             prose-img:rounded-2xl"
      set:html={html}
    />

    <!-- Share + enquiry -->
    <div class="mx-auto mt-12 max-w-[680px] px-4 sm:px-0">
      <div class="flex items-center justify-between border-y border-ink/10 py-4">
        <ShareButton path={path} title={post.title} text={post.excerpt} />
        <a href="/blog/" class="text-sm font-semibold text-primary hover:underline">← Back to blog</a>
      </div>

      <aside class="mt-10 rounded-2xl bg-cream p-6 sm:p-8">
        <h2 class="text-xl font-semibold text-ink">Questions about our shoes or bags?</h2>
        <p class="mt-2 text-ink/70">Send us a message and we'll help you choose the right piece.</p>
        <a
          href={whatsappLink(`Hello VendorLift, I just read "${post.title}" and have a question.`)}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex rounded-full bg-primary px-7 py-3 font-semibold text-white transition hover:bg-accent hover:text-ink"
        >
          Chat on WhatsApp
        </a>
      </aside>
    </div>
  </article>

  <!-- Related products (PRD 6.3: posts link to related products) -->
  {relatedProducts.length > 0 && (
    <section aria-labelledby="shop-heading" class="mt-20 bg-cream py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <SectionHeading id="shop-heading" eyebrow="Shop the collection" title="Pieces you'll love" />
        <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 lg:grid-cols-4">
          {relatedProducts.map((product, i) => (
            <li data-reveal style={`--reveal-delay: ${i * 120}ms`}>
              <ProductCard product={product} headingTag="h3" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- More posts -->
  {relatedPosts.length > 0 && (
    <section aria-labelledby="more-posts-heading" class="bg-white py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <SectionHeading id="more-posts-heading" eyebrow="Keep reading" title="More from the blog" />
        <ul class="mt-10 grid gap-x-6 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
          {relatedPosts.map((item, i) => (
            <li data-reveal style={`--reveal-delay: ${i * 120}ms`}>
              <PostCard post={item} headingTag="h3" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>