{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-17",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "ecommerce-template",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vendorlift-ecommerce-db",
			"database_id": "14cae5b9-1a09-4e56-89be-c31bd1742c50"
		}
	]
}